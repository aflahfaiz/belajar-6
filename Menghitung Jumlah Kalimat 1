// Online C++ compiler to run C++ program online
#include <iostream>
using namespace std;

int main() {
    string a, b;
    int c = 0;
    cin >> a >> b;
    
    for (int i = 0; i < b.length(); i++) {
        
        if (a[0] == b[1]) {
            cout << a[0] << "==" << b[i] << endl;
            c++;
        }
    }
    cout << c;
    
    return 0;
}
