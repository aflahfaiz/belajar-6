#include <iostream>
using namespace std;
int pangkat(int a, int p) {
    int nilai = a;
    for ( int i=1; i < p; i++) {
        nilai *= a;
    }
    return nilai;
}

int main() {
    int p, q, n, m, total = 0;
    cin >> p >> q >> n >> m;
    
    for (int k = 1; k <= n; k+=1) {
        total += (pangkat(p, k)) * (pangkat(k, q));
    }
     cout << total % m;

    return 0;
}
